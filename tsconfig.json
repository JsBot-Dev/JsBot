{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "ignoreDeprecations":"6.0",
        "baseUrl":".",
        "paths": {
            "@/*": ["./src/*"],
            "@app/*": ["./src/app/*"]
        },
        "target": "ES2020",
        "module": "es2022",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}